{
  "name": "cep-automation-cypress",
  "version": "1.0.0",
  "description": "CEP V2 Automation Project with Cypress, Page Object Model, and Allure Reports",
  "main": "index.js",
  "scripts": {
    "cypress:open": "cypress run --browser chrome --headed",
    "cypress:run": "cypress run --browser chrome --env allure=true",
    "allure:clear": "node -e \"const fs=require('fs'); ['allure-results','allure-report'].forEach((dir)=>fs.existsSync(dir)&&fs.rmSync(dir,{recursive:true,force:true}));\"",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "test:allure": "npm run allure:clear && npm run cypress:run || true && npm run allure:generate",
    "test": "npm run cypress:run"
  },
  "keywords": [
    "cypress",
    "automation",
    "testing",
    "pom",
    "allure-report",
    "cep-v2"
  ],
  "author": "QA Automation",
  "license": "ISC",
  "devDependencies": {
    "@shelex/cypress-allure-plugin": "^2.41.2",
    "allure-commandline": "^2.43.0",
    "cypress": "^13.0.0"
  }
}
